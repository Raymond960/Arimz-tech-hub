{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{server-data/**,server-dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api|uploads|assets|favicon|manifest|sw\\.js|icon|logo|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
