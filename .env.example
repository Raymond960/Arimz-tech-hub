# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# SHENDAM CONNECT ADMIN AUTHENTICATION
# ==========================================
# Super Administrator email address for admin portal login
ADMIN_EMAIL="domnanraymond9@gmail.com"

# Administrator password or SHA-256 password hash
ADMIN_PASSWORD_HASH="ShendamAdmin2026!"

# Secret key used for signing administrator session tokens
JWT_SECRET="shendam_connect_secret_jwt_key_2026"

# Session expiration time in milliseconds (default: 24 hours = 86400000)
ADMIN_SESSION_TTL_MS="86400000"

# Real-time active users heartbeat timeout in milliseconds (default: 90 seconds = 90000)
ACTIVE_USER_TIMEOUT_MS="90000"

# ==========================================
# SUPABASE DATABASE (OPTIONAL)
# ==========================================
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase Anon / Public API Key
VITE_SUPABASE_ANON_KEY=

# ==========================================
# SMTP EMAIL SERVICE (EMAIL OTP & ADMIN INVITATIONS)
# ==========================================
# Server-side only: Never use VITE_ prefix or expose in frontend
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
# Your full Gmail/Google account address (e.g. yourname@gmail.com)
SMTP_USER=""
# For Gmail, this MUST be a 16-character Google App Password (not your normal Google account password).
# Generate your 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_PASS=""
EMAIL_FROM=""
SMTP_FROM_NAME="Shendam Connect"
SMTP_FROM_EMAIL=""
FRONTEND_URL="https://shendamconnectapp.vercel.app/"
ADMIN_INVITE_EXP="48h"
ADMIN_INVITE_EXPIRY_HOURS="48"

# ==========================================
# MONETIZATION & ADVERTISING SYSTEM
# ==========================================
# Google Advertising (Web AdSense & Android AdMob Native Advanced)
GOOGLE_ADS_ENABLED="false"
VITE_GOOGLE_ADS_ENABLED="false"
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_SLOT_ID=""
VITE_GOOGLE_ADS_CLIENT_ID=""

# Google AdMob Android (Native Advanced Ads)
# App ID: ca-app-pub-1826892014871317~8604829389 (Configured in AndroidManifest.xml)
# Production Native Ad Unit ID: ca-app-pub-1826892014871317/1741617146
# Google Official Test Native Ad Unit ID: ca-app-pub-3940256099942544/2247696110
VITE_ADMOB_NATIVE_AD_UNIT_ID="ca-app-pub-3940256099942544/2247696110"
VITE_ADMOB_TEST_MODE="true"

# Paystack Payment Gateway (Local Sponsored Ads automated checkout)
PAYSTACK_SECRET_KEY=""
VITE_PAYSTACK_PUBLIC_KEY=""


