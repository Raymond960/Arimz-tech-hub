# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# SHENDAM CONNECT ADMIN AUTHENTICATION
# ==========================================
# Super Administrator email address for admin portal login
ADMIN_EMAIL="domnanraymond9@gmail.com"

# Administrator password or SHA-256 password hash
ADMIN_PASSWORD_HASH="ShendamAdmin2026!"

# Secret key used for signing administrator session tokens
JWT_SECRET="shendam_connect_secret_jwt_key_2026"

# Session expiration time in milliseconds (default: 24 hours = 86400000)
ADMIN_SESSION_TTL_MS="86400000"

# Real-time active users heartbeat timeout in milliseconds (default: 90 seconds = 90000)
ACTIVE_USER_TIMEOUT_MS="90000"

# ==========================================
# SUPABASE DATABASE (OPTIONAL)
# ==========================================
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase Anon / Public API Key
VITE_SUPABASE_ANON_KEY=

# ==========================================
# SMTP EMAIL SERVICE (ADMIN INVITATIONS)
# ==========================================
# Server-side only: Never use VITE_ prefix or expose in frontend
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Shendam Connect"
SMTP_FROM_EMAIL=""
FRONTEND_URL="https://shendamconnectapp.vercel.app/"
ADMIN_INVITE_EXP="24h"
ADMIN_INVITE_EXPIRY_HOURS="24"

# ==========================================
# MONETIZATION & ADVERTISING SYSTEM
# ==========================================
# Google Advertising (Web/PWA AdSense & Future Mobile AdMob)
GOOGLE_ADS_ENABLED="false"
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_SLOT_ID=""
VITE_GOOGLE_ADS_CLIENT_ID=""

# Paystack Payment Gateway (Local Sponsored Ads automated checkout)
PAYSTACK_SECRET_KEY=""
VITE_PAYSTACK_PUBLIC_KEY=""


